{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://model-maker.internal/schemas/model-maker-bridge.schema.json",
  "title": "Model Maker Bridge Package",
  "description": "Tekla Structures -> Model Maker koprusunun surumlu paket bicimi (V1/V2/V3). Tekla Open API extractor'unun urettigi, Model Maker C++ importer'inin okudugu ara temsil. Tekla GUID'leri YALNIZCA kaynak referansidir; Model Maker EntityId'si importer tarafindan atanir. V3: relationships.json (semantik iliskiler), operations.json (cut/fitting/boolean), checksums.json (dosya butunlugu), roleKey + geometryRepresentation + confidence etiketleri ekler. V1/V2 paketleri bu semada da gecerlidir (V3 dosyalari opsiyoneldir).",
  "type": "object",
  "required": ["manifest", "component", "parameters", "objects", "diagnostics"],
  "additionalProperties": false,
  "properties": {
    "manifest": {
      "type": "object",
      "required": [
        "formatVersion",
        "sourceApplication",
        "sourceVersion",
        "sourceComponentType",
        "sourceComponentNumber",
        "exportTimestamp",
        "coordinateSystem",
        "lengthUnit",
        "componentIdentifier"
      ],
      "additionalProperties": true,
      "properties": {
        "formatVersion": { "type": "string", "pattern": "^[123]\\.0$" },
        "sourceApplication": { "const": "Tekla Structures" },
        "sourceVersion": { "type": "string" },
        "producer": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "name": { "type": "string" },
            "version": { "type": "string" }
          }
        },
        "sourceComponentType": {
          "enum": ["Connection", "Component", "Detail", "CustomPart", "Seam", "Unknown"]
        },
        "sourceComponentNumber": { "type": "integer", "minimum": 0 },
        "sourceComponentName": { "type": "string" },
        "sourceModelIdentifier": { "type": "string" },
        "sourceModelName": { "type": "string" },
        "exportTimestamp": { "type": "string", "format": "date-time" },
        "coordinateSystem": { "const": "TeklaGlobal" },
        "lengthUnit": { "const": "mm" },
        "componentIdentifier": { "type": "string" },
        "exportedObjectCount": { "type": "integer", "minimum": 0 },
        "knownLimitations": { "type": "array", "items": { "type": "string" } },
        "exporterVersion": { "type": "string" }
      }
    },
    "component": {
      "type": "object",
      "required": ["sourceType", "name", "number", "guid", "coordinateSystem", "primaryMember", "secondaryMembers"],
      "additionalProperties": true,
      "properties": {
        "sourceType": { "type": "string" },
        "name": { "type": "string" },
        "number": { "type": "integer" },
        "guid": { "type": "string" },
        "identifierId": { "type": "integer" },
        "positionType": { "type": "string" },
        "upVector": { "$ref": "#/definitions/vec3" },
        "selectionOrder": { "type": "array", "items": { "type": "string" } },
        "coordinateSystem": {
          "type": "object",
          "required": ["origin", "xAxis", "yAxis", "zAxis"],
          "additionalProperties": true,
          "properties": {
            "origin": { "$ref": "#/definitions/vec3" },
            "xAxis": { "$ref": "#/definitions/vec3" },
            "yAxis": { "$ref": "#/definitions/vec3" },
            "zAxis": { "$ref": "#/definitions/vec3" }
          }
        },
        "primaryMember": { "$ref": "#/definitions/memberRef" },
        "secondaryMembers": { "type": "array", "items": { "$ref": "#/definitions/memberRef" } },
        "inputReferences": { "type": "array", "items": { "$ref": "#/definitions/memberRef" } }
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "value", "source", "readable", "confidence"],
        "additionalProperties": true,
        "properties": {
          "name": { "type": "string" },
          "type": {
            "enum": ["Length", "Angle", "Integer", "Boolean", "Enum", "String", "Profile", "Material", "EntityRef", "Double", "Unknown"]
          },
          "value": {},
          "units": { "type": "string" },
          "source": { "type": "string" },
          "readable": { "enum": ["ok", "unsupported", "error"] },
          "confidence": { "enum": ["documented", "observed", "inferred", "unresolved", "unsupported"] }
        }
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sourceGUID", "kind", "roleKey"],
        "additionalProperties": true,
        "properties": {
          "sourceGUID": { "type": "string" },
          "identifierId": { "type": "integer" },
          "kind": {
            "enum": ["Beam", "ContourPlate", "PolyBeam", "BoltGroup", "Weld", "BooleanPart", "Fitting", "ConstructionPlane", "Unknown"]
          },
          "name": { "type": "string" },
          "role": { "type": "string" },
          "roleKey": { "type": "string" },
          "profile": { "type": "string" },
          "material": { "type": "string" },
          "parentSourceGUID": { "type": "string" },
          "mapped": { "type": "boolean" },
          "mappedKind": { "enum": ["Plate", "BoltGroup", "Cut", "Weld", "Beam", "Fitting", "ReferenceGeometry", "Unsupported"] },
          "geometryFile": { "type": "string" },
          "geometryRepresentation": { "enum": ["exact", "reconstructed", "approximate", "reference", "unsupported"] },
          "confidence": { "enum": ["documented", "observed", "inferred", "unresolved", "unsupported"] },
          "localToGlobal": { "$ref": "#/definitions/transform" },
          "parametric": { "type": "object", "additionalProperties": true },
          "unsupportedReason": { "type": "string" },
          "boltGroup": { "$ref": "#/definitions/boltGroup" },
          "weld": { "$ref": "#/definitions/weld" },
          "fitting": { "$ref": "#/definitions/fitting" },
          "booleanPart": { "$ref": "#/definitions/booleanPart" },
          "topology": { "$ref": "#/definitions/topology" }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "sourceGUID", "targetGUID"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "kind": {
            "enum": ["partOf", "boltedTo", "weldedTo", "cutBy", "fittedTo", "attachedTo", "memberOf", "secondaryOf", "operatedBy"]
          },
          "sourceGUID": { "type": "string" },
          "targetGUID": { "type": "string" },
          "role": { "type": "string" },
          "confidence": { "enum": ["documented", "observed", "inferred", "unresolved", "unsupported"] }
        }
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "targetPartGUID"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "type": { "enum": ["Cut", "Fitting", "BooleanCut", "BooleanUnion", "BoltHole"] },
          "targetPartGUID": { "type": "string" },
          "operatorGUID": { "type": "string" },
          "cuttingSolidGUID": { "type": "string" },
          "fittingPlane": { "$ref": "#/definitions/plane" },
          "keepSide": { "enum": ["positive", "negative", ""] },
          "inferred": { "type": "boolean" },
          "confidence": { "enum": ["documented", "observed", "inferred", "unresolved", "unsupported"] },
          "finalSolidGeometryFile": { "type": "string" }
        }
      }
    },
    "checksums": {
      "type": "object",
      "description": "Paket icindeki goreli dosya yolu -> SHA-256 hex (butunluk dogrulamasi).",
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
    },
    "diagnostics": {
      "type": "object",
      "required": ["knownLimitations", "inaccessibleObjects", "unsupportedFeatures", "warnings"],
      "additionalProperties": true,
      "properties": {
        "knownLimitations": { "type": "array", "items": { "type": "string" } },
        "inaccessibleObjects": { "type": "array", "items": { "type": "string" } },
        "unsupportedFeatures": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "errors": { "type": "array", "items": { "type": "string" } },
        "unresolvedObjects": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "definitions": {
    "vec3": {
      "type": "object",
      "required": ["x", "y", "z"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "plane": {
      "type": "object",
      "required": ["origin", "normal"],
      "additionalProperties": true,
      "properties": {
        "origin": { "$ref": "#/definitions/vec3" },
        "normal": { "$ref": "#/definitions/vec3" }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "origin": { "$ref": "#/definitions/vec3" },
        "xAxis": { "$ref": "#/definitions/vec3" },
        "yAxis": { "$ref": "#/definitions/vec3" },
        "zAxis": { "$ref": "#/definitions/vec3" },
        "matrix": {
          "type": "array",
          "description": "4x4 satir-oncelikli donusum matrisi (dilimde kolon-oncelikli kullanilmaz).",
          "items": { "type": "array", "items": { "type": "number" } }
        }
      }
    },
    "memberRef": {
      "type": "object",
      "required": ["guid"],
      "additionalProperties": true,
      "properties": {
        "guid": { "type": "string" },
        "identifierId": { "type": "integer" },
        "profile": { "type": "string" },
        "material": { "type": "string" },
        "role": { "type": "string" },
        "roleKey": { "type": "string" },
        "startPoint": { "$ref": "#/definitions/vec3" },
        "endPoint": { "$ref": "#/definitions/vec3" },
        "class": { "type": "string" }
      }
    },
    "bolt": {
      "type": "object",
      "required": ["position"],
      "additionalProperties": true,
      "properties": {
        "position": { "$ref": "#/definitions/vec3" },
        "nominalDiameter": { "type": "number" },
        "holeDiameter": { "type": "number" },
        "holeDiameterSource": { "enum": ["standard", "measured", ""] },
        "axis": { "type": "string" },
        "axisSource": { "enum": ["measured", "inferred", ""] }
      }
    },
    "boltGroup": {
      "type": "object",
      "required": ["bolts"],
      "additionalProperties": true,
      "properties": {
        "size": { "type": "string" },
        "standardCode": { "type": "integer" },
        "tolerance": { "type": "number" },
        "slottedHoleX": { "type": "number" },
        "slottedHoleY": { "type": "number" },
        "partToBeBolted": { "type": "string" },
        "partToBoltTo": { "type": "string" },
        "axis": { "type": "string" },
        "axisSource": { "enum": ["measured", "inferred", ""] },
        "direction": { "$ref": "#/definitions/vec3" },
        "boltType": { "type": "string" },
        "boltStandard": { "type": "string" },
        "bolts": { "type": "array", "items": { "$ref": "#/definitions/bolt" } }
      }
    },
    "weld": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": { "type": "string" },
        "size": { "type": "number" },
        "sizeAbove": { "type": "number" },
        "sizeBelow": { "type": "number" },
        "mainSourceGUID": { "type": "string" },
        "secondarySourceGUID": { "type": "string" },
        "position": { "type": "string" }
      }
    },
    "fitting": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "plane": { "$ref": "#/definitions/plane" },
        "normal": { "$ref": "#/definitions/vec3" },
        "targetPartGUID": { "type": "string" },
        "keepSide": { "enum": ["positive", "negative", ""] },
        "inferred": { "type": "boolean" }
      }
    },
    "booleanPart": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "operationType": { "enum": ["Cut", "Union", "Intersect"] },
        "targetPartGUID": { "type": "string" },
        "operandGUID": { "type": "string" },
        "inferred": { "type": "boolean" }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "faceCount": { "type": "integer" },
        "loopCount": { "type": "integer" },
        "faceVertexOccurrences": { "type": "integer" },
        "holeLoops": { "type": "integer" }
      }
    }
  }
}
