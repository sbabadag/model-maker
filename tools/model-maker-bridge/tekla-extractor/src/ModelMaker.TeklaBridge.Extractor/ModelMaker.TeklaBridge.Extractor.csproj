<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>ModelMaker.TeklaBridge.Extractor</RootNamespace>
    <AssemblyName>TeklaBridge.Extractor</AssemblyName>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tekla Open API 2025 (NuGet). Surum Directory.Build.props -> TeklaApiVersion. -->
    <PackageReference Include="Tekla.Structures.Model" Version="$(TeklaApiVersion)" />
    <!-- exe.config'i Tekla baglantisi icin otomatik uretir (Windows'ta). -->
    <PackageReference Include="TSAppConfigPatcherTask" Version="2.1.3" />
    <!-- net48 hedefini Windows disinda da derlenebilir kilar. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Tekla remoting istemcisi (Trimble.Remoting) eski assembly surumlerini ister
         (System.Memory 4.0.1.2, System.Buffers 4.0.2.0). Tekla.Structures.Model NuGet'i
         bunlari net48 ciktisina transitif kopyalamaz; System.Memory 4.5.5 de daha yeni
         System.Buffers (4.0.3.0) ceker ve binding redirect olmadan FileLoadException verir.
         Dort assembly'yi de acik pin'leyip App.config'de kapsamli redirect uygula. -->
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="System.Buffers" Version="4.5.1" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="4.5.3" />
    <PackageReference Include="System.Numerics.Vectors" Version="4.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModelMaker.TeklaBridge.Core\ModelMaker.TeklaBridge.Core.csproj" />
  </ItemGroup>

</Project>
