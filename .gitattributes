# Bridge paket fixture'lari byte-ayni kalmalidir: checksum'lar ham dosya baytlari
# uzerinden hesaplanir (SHA-256). Windows git'in core.autocrlf ayari checkout'ta
# LF -> CRLF cevirip butunluk dogrulamasini (checksums.json) bozuyor. -text ile
# bu dosyalarda satir sonu donusumu tamamen kapatilir; her platformda byte-ayni.
tools/model-maker-bridge/fixtures/** -text

# MM-5: KOMPONENT PAKETLERI de byte-ayni kalmali — checksums.json SHA-256 ham
# baytlar uzerinden dogrulanir. Windows core.autocrlf=true bu dosyalari CRLF
# yapinca butun paketler sessizce reddediliyordu (ZBook'da yasandi).
libs/mm_contract/packages/** -text

# MM-5 GT fixture'lari (tests/fixtures: p1_*, studio_pkgs, gt1, golden) de
# ayni sekilde byte-ayni kalmali — paket kurulumu ve checksum dogrulama testleri
# bu dosyalari ham bayt olarak okur. Ayni CRLF tuzagi: Windows autocrlf=true
# checkout'ta LF -> CRLF yapip checksums.json butunlugunu bozuyordu.
tests/fixtures/** -text
