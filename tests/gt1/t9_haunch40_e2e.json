{
  "backend": "gdi",
  "timeoutMs": 120000,
  "steps": [
    {"profile": "HEB240"},
    {"appColumnLevels": {"top": 7000, "bottom": 0}},
    {"placeColumn": {"x": 0, "y": 0, "z": 0}},
    {"expect": {"models": {"count": 1, "profiled": 1}}},
    {"expect": {"modelAxis": {"model": 0, "fromX": 0, "fromY": 0, "fromZ": 0, "toX": 0, "toY": 0, "toZ": 7000, "tol": 5}}},
    {"assignLine": {"x1": 0, "y1": 0, "z1": 7000, "x2": 6000, "y2": 0, "z2": 7500, "profile": "IPE300"}},
    {"expect": {"models": {"count": 2, "profiled": 2}}},
    {"expect": {"modelProfile": {"model": 1, "name": "IPE300"}}},
    {"appComponent": {"typeId": "tekla_haunch_40", "parts": [0, 1], "params": {"haunchDepth": 500, "haunchTipDepth": 30}}},
    {"expect": {"componentCount": {"typeId": "tekla_haunch_40", "count": 1}}},
    {"expect": {"componentAttached": {"typeId": "tekla_haunch_40", "maxGap": 500}}},
    {"expect": {"componentDigest": {"typeId": "tekla_haunch_40", "key": "h1", "remember": true}}},
    {"capture": {"name": "t9-haunch-kurulum", "target": "window"}},
    {"select": [0]},
    {"appColumnLevels": {"top": 7200, "bottom": 0}},
    {"expect": {"modelAxis": {"model": 0, "toZ": 7200, "tol": 5}}},
    {"expect": {"modelAxis": {"model": 1, "fromZ": 7200, "tol": 5}}},
    {"expect": {"componentAttached": {"typeId": "tekla_haunch_40", "maxGap": 500}}},
    {"expect": {"componentDigest": {"typeId": "tekla_haunch_40", "key": "h1", "notEquals": true}}},
    {"expect": {"componentDigest": {"typeId": "tekla_haunch_40", "key": "h2", "remember": true}}},
    {"assignProfile": {"model": 1, "profile": "IPE400"}},
    {"expect": {"modelAxis": {"model": 0, "fromZ": 0, "toZ": 7200, "tol": 5}}},
    {"expect": {"modelProfile": {"model": 1, "name": "IPE400"}}},
    {"expect": {"componentAttached": {"typeId": "tekla_haunch_40", "maxGap": 500}}},
    {"expect": {"componentDigest": {"typeId": "tekla_haunch_40", "key": "h2", "notEquals": true}}},
    {"expect": {"componentDigest": {"typeId": "tekla_haunch_40", "key": "h3", "remember": true}}},
    {"save": "t9-haunch.mmd"},
    {"open": "t9-haunch.mmd"},
    {"expect": {"modelAxis": {"model": 0, "fromZ": 0, "toZ": 7200, "tol": 5}}},
    {"expect": {"modelProfile": {"model": 1, "name": "IPE400"}}},
    {"expect": {"componentDigest": {"typeId": "tekla_haunch_40", "key": "h3", "equals": true}}},
    {"expect": {"componentAttached": {"typeId": "tekla_haunch_40", "maxGap": 500}}},
    {"capture": {"name": "t9-haunch-final", "target": "window"}},
    {"wait": 150}
  ]
}
