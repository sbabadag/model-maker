{
  "backend": "gdi",
  "timeoutMs": 120000,
  "steps": [
    {
      "assignLine": {
        "x1": 0,
        "y1": 0,
        "z1": 3000,
        "x2": 5000,
        "y2": 0,
        "z2": 3000,
        "profile": "HEB240"
      }
    },
    {
      "expect": {
        "models": {
          "count": 1,
          "profiled": 1
        },
        "viewports": 1
      }
    },
    {
      "fit": {}
    },
    {
      "cmd": "view.toSurface"
    },
    {
      "expect": {
        "status": {
          "contains": "GÖRE GÖRÜNÜŞ"
        }
      }
    },
    {
      "faceClick": {
        "model": 0,
        "kind": "top"
      }
    },
    {
      "expect": {
        "viewports": 2,
        "status": {
          "contains": "açıldı"
        }
      }
    },
    {
      "expect": {
        "viewTitle": {
          "contains": "yüzey görünüşü",
          "notContains": "Plan"
        }
      }
    },
    {
      "expect": {
        "viewOriginZ": {
          "value": 3000,
          "tol": 5
        }
      }
    },
    {
      "fit": {}
    },
    {
      "cmd": "view.dir.front"
    },
    {
      "cmd": "view.toSurface"
    },
    {
      "faceClick": {
        "model": 0,
        "kind": "side"
      }
    },
    {
      "expect": {
        "viewports": 3
      }
    },
    {
      "expect": {
        "viewTitle": {
          "contains": "yüzey görünüşü",
          "notContains": "Plan"
        }
      }
    },
    {
      "expect": {
        "viewNormalZ": {
          "absBelow": 0.1
        }
      }
    },
    {
      "capture": {
        "name": "h1-yuzey-gorunusleri",
        "target": "window"
      }
    },
    {
      "wait": 150
    }
  ]
}
