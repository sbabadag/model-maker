{
  "backend": "gdi",
  "timeoutMs": 120000,
  "steps": [
    {"profile": "HEB240"},
    {"appColumnLevels": {"top": 4000, "bottom": 0}},
    {"placeColumn": {"x": 0, "y": 0, "z": 0}},
    {"expect": {"models": {"count": 1, "profiled": 1}}},
    {"expect": {"modelAxis": {"model": 0, "fromZ": 0, "toZ": 4000, "tol": 5}}},
    {"assignLine": {"x1": 0, "y1": 0, "z1": 4000, "x2": 5000, "y2": 0, "z2": 4000, "profile": "IPE300"}},
    {"expect": {"models": {"count": 2, "profiled": 2}}},
    {"expect": {"modelProfile": {"model": 1, "name": "IPE300"}}},
    {"appComponent": {"typeId": "beam_to_column_end_plate", "parts": [0, 1]}},
    {"expect": {"componentCount": {"typeId": "beam_to_column_end_plate", "count": 1}}},
    {"expect": {"componentAttached": {"typeId": "beam_to_column_end_plate", "maxGap": 500}}},
    {"expect": {"componentDigest": {"typeId": "beam_to_column_end_plate", "key": "e1", "remember": true}}},
    {"capture": {"name": "t9-endplate-kurulum", "target": "window"}},
    {"select": [0]},
    {"appColumnLevels": {"top": 4300, "bottom": 0}},
    {"expect": {"modelAxis": {"model": 0, "toZ": 4300, "tol": 5}}},
    {"expect": {"modelAxis": {"model": 1, "fromZ": 4300, "toZ": 4000, "tol": 5}}},
    {"expect": {"componentAttached": {"typeId": "beam_to_column_end_plate", "maxGap": 500}}},
    {"expect": {"componentDigest": {"typeId": "beam_to_column_end_plate", "key": "e1", "notEquals": true}}},
    {"expect": {"componentDigest": {"typeId": "beam_to_column_end_plate", "key": "e2", "remember": true}}},
    {"save": "t9-endplate.mmd"},
    {"open": "t9-endplate.mmd"},
    {"expect": {"modelAxis": {"model": 0, "toZ": 4300, "tol": 5}}},
    {"expect": {"modelAxis": {"model": 1, "fromZ": 4300, "toZ": 4000, "tol": 5}}},
    {"expect": {"componentDigest": {"typeId": "beam_to_column_end_plate", "key": "e2", "equals": true}}},
    {"expect": {"componentAttached": {"typeId": "beam_to_column_end_plate", "maxGap": 500}}},
    {"capture": {"name": "t9-endplate-final", "target": "window"}},
    {"wait": 150}
  ]
}
