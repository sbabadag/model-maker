{
  "backend": "gdi",
  "timeoutMs": 180000,
  "_comment": "P-1/3 — SURUM YUKSELTMESI + PARAMETRE ESLEME: kurulu v1 uzerinde plateThickness=16 -> gelistirme klasorunde v3 (schemaVersion 3; plateFinish KALKTI, plateCorner EKLENDI, plateExtra ust siniri 20->10) -> reload -> kullanici degeri KORUNUR, plateExtra KELEPCELENIR (geometri degisir), plateFinish ATILIR; esleme kayda yazilir (kaydet/ac ayni digest).",
  "steps": [
    {
      "appImportPackage": {
        "path": "../fixtures/p1_pkg",
        "embed": false,
        "userRoot": "components"
      }
    },
    {
      "componentTypeRegistered": {
        "typeId": "mm_p1_gt_pkg",
        "package": true,
        "schemaVersion": 1
      }
    },
    {
      "profile": "HEB240"
    },
    {
      "appColumnLevels": {
        "top": 7000,
        "bottom": 0
      }
    },
    {
      "placeColumn": {
        "x": 0,
        "y": 0,
        "z": 0
      }
    },
    {
      "assignLine": {
        "x1": 0,
        "y1": 0,
        "z1": 7000,
        "x2": 6000,
        "y2": 0,
        "z2": 7000,
        "profile": "IPE300"
      }
    },
    {
      "appComponent": {
        "typeId": "mm_p1_gt_pkg",
        "parts": [
          0,
          1
        ]
      }
    },
    {
      "expect": {
        "componentCount": {
          "typeId": "mm_p1_gt_pkg",
          "count": 1
        }
      }
    },
    {
      "appComponentParams": {
        "typeId": "mm_p1_gt_pkg",
        "params": {
          "plateThickness": 16.0
        }
      }
    },
    {
      "expect": {
        "componentDigest": {
          "typeId": "mm_p1_gt_pkg",
          "key": "v1-sonrasi",
          "remember": true
        }
      }
    },
    {
      "appReloadPackages": {
        "devDirs": [
          "../fixtures/p1_dev3"
        ]
      }
    },
    {
      "componentTypeRegistered": {
        "typeId": "mm_p1_gt_pkg",
        "package": true,
        "schemaVersion": 3
      }
    },
    {
      "expect": {
        "packageMessage": {
          "contains": [
            "1 tip",
            "korundu",
            "atıldı",
            "kelepçelendi"
          ],
          "excludes": [
            "ESKİ hâlinde"
          ]
        }
      }
    },
    {
      "expect": {
        "componentCount": {
          "typeId": "mm_p1_gt_pkg",
          "count": 1
        }
      }
    },
    {
      "expect": {
        "componentDigest": {
          "typeId": "mm_p1_gt_pkg",
          "key": "v1-sonrasi",
          "notEquals": true
        }
      }
    },
    {
      "expect": {
        "componentDigest": {
          "typeId": "mm_p1_gt_pkg",
          "key": "v3-sonrasi",
          "remember": true
        }
      }
    },
    {
      "fit": true
    },
    {
      "capture": {
        "name": "t17-v3-yeniden-uretildi",
        "target": "window"
      }
    },
    {
      "save": "t17_v3.mmw"
    },
    {
      "open": "t17_v3.mmw"
    },
    {
      "expect": {
        "componentCount": {
          "typeId": "mm_p1_gt_pkg",
          "count": 1
        }
      }
    },
    {
      "expect": {
        "componentDigest": {
          "typeId": "mm_p1_gt_pkg",
          "key": "v3-sonrasi",
          "equals": true
        }
      }
    },
    {
      "capture": {
        "name": "t17-kaydet-ac-ayni",
        "target": "window"
      }
    }
  ]
}
