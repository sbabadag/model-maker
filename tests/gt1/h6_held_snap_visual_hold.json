{
  "backend": "gdi",
  "timeoutMs": 120000,
  "steps": [
    {"gridSnap": false},
    {"cmd": "draw.line"},
    {"click": [250, 300]},
    {"click": [450, 300]},
    {"key": "esc"},
    {"expect": {"models": {"count": 1, "plain": 1}}},
    {"snapHold": 600},
    {"cmd": "draw.line"},
    {"move": [450, 300]},
    {"move": [450, 300]},
    {"wait": 100},
    {"expect": {"snapState": {"held": true, "fading": false, "type": "ENDPOINT"}}},
    {"captureLive": {"name": "h6-held-marker", "at": [450, 300]}},
    {"move": [650, 300]},
    {"wait": 100},
    {"expect": {"snapState": {"held": false, "fading": true}}},
    {"captureLive": {"name": "h6-fade-visible", "at": [650, 300]}},
    {"click": [650, 300]},
    {"move": [850, 300]},
    {"click": [850, 300]},
    {"key": "esc"},
    {"expect": {"models": {"count": 2, "plain": 2}}},
    {"expect": {"vertexScreen": {"model": 0, "vertex": 0, "x": 250, "y": 300, "tol": 10}}},
    {"expect": {"vertexScreen": {"model": 1, "vertex": 0, "x": 650, "y": 300, "tol": 10}}},
    {"cmd": "draw.line"},
    {"move": [450, 300]},
    {"move": [450, 300]},
    {"wait": 80},
    {"expect": {"snapState": {"held": true, "fading": false}}},
    {"move": [650, 500]},
    {"wait": 100},
    {"expect": {"snapState": {"held": false, "fading": true}}},
    {"wait": 600},
    {"expect": {"snapState": {"held": false, "fading": false}}},
    {"captureLive": {"name": "h6-fade-gone", "at": [700, 500]}},
    {"key": "esc"},
    {"capture": {"name": "h6-final", "target": "window"}},
    {"wait": 150}
  ]
}
