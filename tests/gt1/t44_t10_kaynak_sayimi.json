        "x": 0,
        "y": 0,
        "z": 0
      }
    },
    {
      "key": "Escape"
    },
    {
      "assignLine": {
        "x1": 0,
        "y1": 0,
        "z1": 4000,
        "x2": 5000,
        "y2": 0,
        "z2": 4000,
        "profile": "IPE300"
      }
    },
    {
      "key": "Escape"
    },
    {
      "appComponent": {
        "typeId": "beam_to_column_end_plate",
        "parts": [
          0,
          1
        ]
      }
    },
    {
      "expect": {
