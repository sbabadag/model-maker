        "size": "param.w_stf"
      }
    },
    {
      "id": "w_col",
      "use": "weld.fillet",
      "role": "weld_base_plate",
      "args": {
        "double": "1",
        "roleA": "base_plate",
        "roleB": "main",
        "size": "param.w_col"
      }
    }
  ]
