        "size": "param.w_stf"
      }
    },
    {
      "id": "s_mp",
      "use": "frame.offset",
      "when": "param.fs_count >= 2",
      "args": {
        "dv": "main.h/2",
        "dw": "param.fs_e",
        "frame": "sm0"
      }
    },
    {
      "id": "p_mp",
      "use": "plate.polygon",
      "role": "stiffener_alt_p",
      "when": "param.fs_count >= 2",
      "args": {
        "frame": "s_mp",
