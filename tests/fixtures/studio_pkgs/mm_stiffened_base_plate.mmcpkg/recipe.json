        "size": "param.w_stf"
      }
    },
    {
      "id": "w2_mw",
      "use": "weld.fillet",
      "role": "weld_stiffener_alt_w_plate",
      "when": "(param.fs_count == 1) || (param.fs_count >= 3)",
      "args": {
        "roleA": "stiffener_alt_w",
