      "when": "param.fs_count >= 2",
      "args": {
        "roleA": "stiffener_alt_p",
        "roleB": "base_plate",
        "size": "param.w_stf"
      }
    },
    {
      "id": "s_mm",
      "use": "frame.offset",
      "when": "param.fs_count >= 2",
      "args": {
        "dv": "main.h/2",
        "dw": "0 - param.fs_e",
        "frame": "sm0"
      }
    },
    {
      "id": "p_mm",
      "use": "plate.polygon",
      "role": "stiffener_alt_m",
      "when": "param.fs_count >= 2",
      "args": {
        "frame": "s_mm",
        "material": "param.fs_material",
        "name": "param.fs_name",
        "outline": [
          "(param.fs_c),0",
          "0,param.fs_c",
          "0,(param.bp_ext_v - param.fs_edge)",
          "param.fs_hTop,(param.bp_ext_v - param.fs_edge)",
          "param.fs_H,0"
        ],
        "t": "param.fs_t"
      }
    },
    {
      "id": "w1_mm",
      "use": "weld.fillet",
      "role": "weld_stiffener_alt_m_column",
      "when": "param.fs_count >= 2",
      "args": {
