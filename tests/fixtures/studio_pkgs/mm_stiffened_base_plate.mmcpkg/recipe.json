        "name": "param.fs_name",
        "outline": [
          "(param.fs_c),0",
          "0,param.fs_c",
          "0,(param.bp_ext_v - param.fs_edge)",
          "param.fs_hTop,(param.bp_ext_v - param.fs_edge)",
          "param.fs_H,0"
        ],
        "t": "param.fs_t"
      }
    },
    {
      "id": "w1_mp",
      "use": "weld.fillet",
